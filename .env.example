# Nebim canlı stok entegrasyonu.
# mock: katalogdaki demo tükenmiş bedenler kullanılır (varsayılan).
# live: gerçek Nebim sağlayıcısı; aşağıdaki üç değer zorunludur.
NEBIM_MODE=mock
NEBIM_BASE_URL=
NEBIM_API_KEY=
NEBIM_COMPANY_CODE=

# POST /api/stock isteğini korur. Üretimde zorunludur.
STOCK_SYNC_TOKEN=

# İsteğe bağlı: SQLite dosyasının yeri (varsayılan .data/rimas.db).
# RIMAS_DB_PATH=

# İsteğe bağlı: telefon/Expo Go için API adresi (varsayılan: Expo'nun host adresi).
# EXPO_PUBLIC_API_URL=http://192.168.1.153:8081
